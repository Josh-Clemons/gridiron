{
  "name": "@gridiron/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "sync": "tsx --env-file-if-exists=../../.env src/sync/cli.ts",
    "reminder": "tsx --env-file-if-exists=../../.env src/reminder/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gridiron/contracts": "workspace:*",
    "@gridiron/rules": "workspace:*",
    "@gridiron/schema": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "postgres": "^3.4.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1"
  }
}
