{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "warn"
  },
  "rules": {
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/max-lines-per-function": "off"
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/coverage/**"]
}
