# Copy to .env for local development.
#
# Port 5433 matches docker-compose.yml, which avoids the host Postgres on 5432.
DATABASE_URL=postgres://gridiron:gridiron@127.0.0.1:5433/gridiron

# --- API ---------------------------------------------------------------------
# 8082 is the port reserved for gridiron on this machine; the API binds it on
# 127.0.0.1 only and Caddy publishes it in Phase 5.
PORT=8082
NODE_ENV=development

# Where the browser reaches the app. Used to build password-reset links and as the
# only origin allowed to make credentialed cross-origin requests. In development
# that's the Vite dev server; in production it's https://gridiron.jdclemons.dev.
APP_URL=http://localhost:5173

# Extra allowed origins, comma separated. Usually empty.
EXTRA_ORIGINS=

# Session cookie lifetime, sliding: an active player is never logged out mid-season.
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60

# `console` prints password-reset links to the log, which is how you use them
# locally. A real provider (Resend/Postmark/SES) is chosen in Phase 5 and becomes a
# new implementation of the Mailer interface — nothing above it changes.
MAIL_TRANSPORT=console

# --- NFL data sync -----------------------------------------------------------
# ESPN's public scoreboard endpoint. Only set ESPN_BASE_URL to point the sync
# somewhere else; unset means the real one.
# ESPN_BASE_URL=
ESPN_TIMEOUT_MS=15000

# Where a failed sync shouts. All three or none — without them it alerts to stderr,
# which cron mails to the local user. Phase 5 supplies these from
# ~/.config/gridiron.env, alongside the room id for #alerts:jdclemons.dev.
# MATRIX_HOMESERVER=http://127.0.0.1:6167
# MATRIX_ACCESS_TOKEN=
# MATRIX_ALERT_ROOM=
