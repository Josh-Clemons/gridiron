# Copy to .env for local development.
#
# Port 5433 matches docker-compose.yml, which avoids the host Postgres on 5432.
DATABASE_URL=postgres://gridiron:gridiron@127.0.0.1:5433/gridiron

# --- API ---------------------------------------------------------------------
# 8082 is the port reserved for gridiron on this machine, and the production
# container holds it around the clock — so development runs on 8083 instead.
# apps/web/vite.config.ts proxies to the same number; change both together.
PORT=8083
NODE_ENV=development

# The interface to bind. Loopback here, because anything on a non-localhost
# address is reachable from every tailnet peer. The container overrides it to
# 0.0.0.0 and gets the same guarantee from Docker publishing to 127.0.0.1.
HOST=127.0.0.1

# Where the browser reaches the app. Used to build password-reset links and as the
# only origin allowed to make credentialed cross-origin requests. In development
# that's the Vite dev server; in production it's https://gridironpicks.us.
APP_URL=http://localhost:5173

# Extra allowed origins, comma separated. Usually empty.
EXTRA_ORIGINS=

# Session cookie lifetime, sliding: an active player is never logged out mid-season.
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60

# `console` prints password-reset links to the log, which is how you use them
# locally. `resend` is the production transport and the only one production accepts —
# booting there with `console` would write working reset links into the journal and
# mail nobody, so loadConfig refuses it.
MAIL_TRANSPORT=console

# Required by MAIL_TRANSPORT=resend, supplied in production from ~/.config/gridiron.env
# alongside the Matrix secrets. MAIL_FROM must be on a domain verified in the Resend
# dashboard — a subdomain, so a deliverability problem can't touch the apex domain's
# reputation. Resend rejects an unverified sender with a 403 at send time.
# RESEND_API_KEY=
# MAIL_FROM=Gridiron <noreply@mail.gridironpicks.us>

# --- Manual testing ----------------------------------------------------------
# Run the server at a simulated moment, so a finished season can be exercised as if
# it were live — otherwise every kickoff is in the past and every slot renders locked.
# It sets an offset from real time rather than freezing the clock, so time still
# advances and a slot can be watched locking. Refused when NODE_ENV=production.
# CLOCK_OVERRIDE=2025-11-20T18:00:00-06:00

# --- NFL data sync -----------------------------------------------------------
# ESPN's public scoreboard endpoint. Only set ESPN_BASE_URL to point the sync
# somewhere else; unset means the real one.
# ESPN_BASE_URL=
ESPN_TIMEOUT_MS=15000

# Where a failed sync shouts. All three or none — without them it alerts to stderr,
# which cron mails to the local user. Phase 5 supplies these from
# ~/.config/gridiron.env, alongside the room id for #alerts:jdclemons.dev.
# MATRIX_HOMESERVER=http://127.0.0.1:6167
# MATRIX_ACCESS_TOKEN=
# MATRIX_ALERT_ROOM=
