{
  "name": "gridiron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @gridiron/api dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @gridiron/schema db:generate",
    "db:migrate": "pnpm --filter @gridiron/schema db:migrate",
    "db:seed": "pnpm --filter @gridiron/schema db:seed",
    "db:studio": "pnpm --filter @gridiron/schema db:studio",
    "db:reset": "docker compose down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
